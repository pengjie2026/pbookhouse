/* ============================================
   蒲草书屋 · 管理后台逻辑
   ============================================ */

console.log('蒲草书屋管理后台脚本加载');\n// ---- 存储 Key ----
const STORAGE_KEY_ARTICLES = 'pugrassbookhouse_articles';
const STORAGE_KEY_CATEGORIES = 'pugrassbookhouse_categories';
const STORAGE_KEY_TAGS = 'pugrassbookhouse_tags';

// ---- 运行时数据（优先读取 localStorage，否则使用 data.js 的原始数据）----
let adminArticles = loadFromStorage(STORAGE_KEY_ARTICLES, ARTICLES);
let adminCategories = loadFromStorage(STORAGE_KEY_CATEGORIES, CATEGORIES);
let adminTags = loadFromStorage(STORAGE_KEY_TAGS, TAGS);

// 当前编辑的文章 ID（null 表示新增）
let currentEditId = null;
// 确认弹窗回调
let confirmCallback = null;

// ============================================================
//  工具函数
// ============================================================

function loadFromStorage(key, defaultData) {
  try {
    const raw = localStorage.getItem(key);
    return raw ? JSON.parse(raw) : JSON.parse(JSON.stringify(defaultData));
  } catch (e) {
    return JSON.parse(JSON.stringify(defaultData));
  }
}

function saveToStorage() {
  localStorage.setItem(STORAGE_KEY_ARTICLES, JSON.stringify(adminArticles));
  localStorage.setItem(STORAGE_KEY_CATEGORIES, JSON.stringify(adminCategories));
  localStorage.setItem(STORAGE_KEY_TAGS, JSON.stringify(adminTags));
}

function generateId() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
}

function showToast(message, type = 'success') {
  const container = document.getElementById('toast-container');
  const icons = { success: '✅', error: '❌', info: 'ℹ️' };
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.innerHTML = `<span>${icons[type] || '✅'}</span><span>${message}</span>`;
  container.appendChild(toast);
  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transition = 'opacity 0.3s';
    setTimeout(() => toast.remove(), 350);
  }, 2800);
}

function formatDate(dateStr) {
  if (!dateStr) return '—';
  return dateStr.replace(/-/g, '/');
}

function getCategoryName(catId) {
  const cat = adminCategories.find(c => c.id === catId);
  return cat ? `${cat.icon} ${cat.name}` : catId;
}

// ============================================================
//  导航切换
// ============================================================

document.querySelectorAll('.nav-item').forEach(item => {
  item.addEventListener('click', e => {
    e.preventDefault();
    const page = item.dataset.page;
    switchPage(page);
  });
});

function switchPage(page) {
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.querySelector(`[data-page="${page}"]`).classList.add('active');
  document.querySelectorAll('.page').forEach(p => p.classList.add('hidden'));
  document.getElementById(`page-${page}`).classList.remove('hidden');

  if (page === 'articles') renderArticleList();
  if (page === 'categories') renderCategoryList();
  if (page === 'tags') renderTagList();
}

// ============================================================
//  文章列表
// ============================================================

function renderArticleList() {
  const tbody = document.getElementById('article-table-body');
  const searchVal = (document.getElementById('search-input').value || '').toLowerCase();
  const catFilter = document.getElementById('filter-category').value;
  const sortVal = document.getElementById('filter-sort').value;

  let list = [...adminArticles];

  // 过滤
  if (searchVal) {
    list = list.filter(a =>
      a.title.toLowerCase().includes(searchVal) ||
      (a.excerpt || '').toLowerCase().includes(searchVal)
    );
  }
  if (catFilter !== 'all') {
    list = list.filter(a => a.category === catFilter);
  }

  // 排序
  if (sortVal === 'date-desc') list.sort((a, b) => (b.date || '').localeCompare(a.date || ''));
  else if (sortVal === 'date-asc') list.sort((a, b) => (a.date || '').localeCompare(b.date || ''));
  else if (sortVal === 'title') list.sort((a, b) => a.title.localeCompare(b.title));

  // 更新描述
  document.getElementById('article-count-desc').textContent = `共 ${adminArticles.length} 篇文章`;

  if (list.length === 0) {
    tbody.innerHTML = `<tr><td colspan="6"><div class="empty-state"><div class="empty-icon">📭</div><p>没有找到匹配的文章</p></div></td></tr>`;
    return;
  }

  tbody.innerHTML = list.map(a => `
    <tr>
      <td>
        <div class="article-title-cell">${a.featured ? '<span class="featured-badge">⭐ 精选</span> ' : ''}${escapeHtml(a.title)}</div>
        <div class="article-excerpt-cell">${escapeHtml(a.excerpt || '')}</div>
      </td>
      <td><span class="category-badge">${getCategoryName(a.category)}</span></td>
      <td style="color:var(--color-text-secondary);font-size:13px">${formatDate(a.date)}</td>
      <td style="color:var(--color-text-secondary);font-size:13px">${a.readTime || '—'}</td>
      <td>${a.featured ? '<span class="featured-badge">⭐</span>' : '<span style="color:var(--color-text-muted)">—</span>'}</td>
      <td>
        <div class="action-buttons">
          <button class="btn btn-sm btn-secondary" onclick="openEditor('${a.id}')">✏️ 编辑</button>
          <button class="btn btn-sm btn-secondary btn-icon" onclick="duplicateArticle('${a.id}')" title="复制">📋</button>
          <button class="btn btn-sm btn-danger" onclick="confirmDeleteArticle('${a.id}')">🗑 删除</button>
        </div>
      </td>
    </tr>
  `).join('');
}

function escapeHtml(str) {
  return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function duplicateArticle(id) {
  const src = adminArticles.find(a => a.id === id);
  if (!src) return;
  const copy = JSON.parse(JSON.stringify(src));
  copy.id = generateId();
  copy.title = copy.title + ' (副本)';
  copy.featured = false;
  copy.date = new Date().toISOString().slice(0, 10);
  adminArticles.unshift(copy);
  saveToStorage();
  renderArticleList();
  showToast('文章已复制');
}

function confirmDeleteArticle(id) {
  const art = adminArticles.find(a => a.id === id);
  if (!art) return;
  openConfirm(`确定要删除文章《${art.title}》吗？此操作不可撤销。`, () => {
    adminArticles = adminArticles.filter(a => a.id !== id);
    // 同步分类数量
    recalcCategoryCounts();
    saveToStorage();
    renderArticleList();
    showToast('文章已删除');
  });
}

function recalcCategoryCounts() {
  adminCategories = adminCategories.map(cat => {
    if (cat.id === 'all') return { ...cat, count: adminArticles.length };
    return { ...cat, count: adminArticles.filter(a => a.category === cat.id).length };
  });
}

// ============================================================
//  文章编辑器
// ============================================================

function openEditor(id) {
  currentEditId = id;
  const modal = document.getElementById('editor-modal');
  const titleEl = document.getElementById('editor-title');
  const idDisplay = document.getElementById('editor-id-display');

  // 填充分类下拉
  const catSelect = document.getElementById('field-category');
  catSelect.innerHTML = adminCategories
    .filter(c => c.id !== 'all')
    .map(c => `<option value="${c.id}">${c.icon} ${c.name}</option>`)
    .join('');

  // 填充标签选择
  renderTagPicker([]);

  if (id === null) {
    // 新增
    titleEl.textContent = '新增文章';
    idDisplay.textContent = '';
    document.getElementById('field-title').value = '';
    document.getElementById('field-excerpt').value = '';
    document.getElementById('field-date').value = new Date().toISOString().slice(0, 10);
    document.getElementById('field-readtime').value = '5 分钟';
    document.getElementById('field-emoji').value = '📄';
    document.getElementById('field-color').value = 'linear-gradient(135deg, #5b7e6e 0%, #a8c5b8 100%)';
    document.getElementById('field-featured').checked = false;
    document.getElementById('field-content').value = '# 文章标题\n\n## 引言\n\n在此输入正文内容…\n\n## 章节一\n\n内容…\n\n## 结语\n\n结尾内容…';
    updateColorPreview();
    renderTagPicker([]);
  } else {
    // 编辑
    const art = adminArticles.find(a => a.id === id);
    if (!art) return;
    titleEl.textContent = '编辑文章';
    idDisplay.textContent = `ID: ${art.id}`;
    document.getElementById('field-title').value = art.title || '';
    document.getElementById('field-excerpt').value = art.excerpt || '';
    document.getElementById('field-date').value = art.date || '';
    document.getElementById('field-readtime').value = art.readTime || '';
    document.getElementById('field-emoji').value = art.coverEmoji || '';
    document.getElementById('field-color').value = art.coverColor || '';
    document.getElementById('field-featured').checked = !!art.featured;
    document.getElementById('field-content').value = art.content || '';
    catSelect.value = art.category;
    updateColorPreview();
    renderTagPicker(art.tags || []);
  }

  switchTab('write');
  modal.classList.remove('hidden');
}

function closeEditor() {
  document.getElementById('editor-modal').classList.add('hidden');
  currentEditId = null;
}

function renderTagPicker(selectedIds) {
  const container = document.getElementById('field-tags');
  container.innerHTML = adminTags.map(tag => `
    <span class="tag-option ${selectedIds.includes(tag.id) ? 'selected' : ''}"
          data-id="${tag.id}"
          onclick="toggleTagOption(this)">
      ${tag.name}
    </span>
  `).join('');
}

function toggleTagOption(el) {
  el.classList.toggle('selected');
}

function getSelectedTags() {
  return Array.from(document.querySelectorAll('.tag-option.selected')).map(el => el.dataset.id);
}

function switchTab(tab) {
  const writeArea = document.getElementById('field-content');
  const previewArea = document.getElementById('md-preview');
  document.getElementById('tab-write').classList.toggle('active', tab === 'write');
  document.getElementById('tab-preview').classList.toggle('active', tab === 'preview');
  if (tab === 'write') {
    writeArea.classList.remove('hidden');
    previewArea.classList.add('hidden');
  } else {
    writeArea.classList.add('hidden');
    previewArea.classList.remove('hidden');
    const md = writeArea.value;
    previewArea.innerHTML = marked.parse(md);
    if (typeof hljs !== 'undefined') {
      previewArea.querySelectorAll('pre code').forEach(el => hljs.highlightElement(el));
    }
  }
}

function updateColorPreview() {
  const val = document.getElementById('field-color').value;
  const preview = document.getElementById('color-preview');
  if (val) {
    preview.style.background = val;
  } else {
    preview.style.background = '#eee';
  }
}

document.getElementById('field-color').addEventListener('input', updateColorPreview);

function saveArticle() {
  const title = document.getElementById('field-title').value.trim();
  if (!title) { showToast('请输入文章标题', 'error'); return; }
  const category = document.getElementById('field-category').value;
  if (!category) { showToast('请选择分类', 'error'); return; }

  const cat = adminCategories.find(c => c.id === category);
  const articleData = {
    title,
    excerpt: document.getElementById('field-excerpt').value.trim(),
    category,
    categoryName: cat ? cat.name : '',
    categoryIcon: cat ? cat.icon : '',
    date: document.getElementById('field-date').value,
    readTime: document.getElementById('field-readtime').value.trim(),
    coverEmoji: document.getElementById('field-emoji').value.trim() || '📄',
    coverColor: document.getElementById('field-color').value.trim(),
    featured: document.getElementById('field-featured').checked,
    tags: getSelectedTags(),
    content: document.getElementById('field-content').value,
  };

  if (currentEditId === null) {
    // 新增
    articleData.id = generateId();
    adminArticles.unshift(articleData);
    showToast('文章已发布 🎉');
  } else {
    // 更新
    const idx = adminArticles.findIndex(a => a.id === currentEditId);
    if (idx === -1) { showToast('文章不存在', 'error'); return; }
    adminArticles[idx] = { ...adminArticles[idx], ...articleData, id: currentEditId };
    showToast('文章已更新 ✨');
  }

  recalcCategoryCounts();
  saveToStorage();
  closeEditor();
  renderArticleList();
}

// ============================================================
//  分类管理
// ============================================================

let currentEditCatId = null;

function renderCategoryList() {
  const container = document.getElementById('category-list');
  const list = adminCategories.filter(c => c.id !== 'all');
  if (list.length === 0) {
    container.innerHTML = `<div class="empty-state"><div class="empty-icon">📂</div><p>暂无分类</p></div>`;
    return;
  }
  container.innerHTML = list.map(cat => `
    <div class="cat-card">
      <div class="cat-card-icon">${cat.icon}</div>
      <div class="cat-card-name">${cat.name}</div>
      <div class="cat-card-id">ID: ${cat.id}</div>
      <div class="cat-card-count">文章 ${cat.count || 0} 篇</div>
      <div class="cat-card-actions">
        <button class="btn btn-sm btn-secondary" onclick="openCategoryEditor('${cat.id}')">✏️ 编辑</button>
        <button class="btn btn-sm btn-danger" onclick="confirmDeleteCategory('${cat.id}')">🗑 删除</button>
      </div>
    </div>
  `).join('');
}

function openCategoryEditor(id) {
  currentEditCatId = id;
  const modal = document.getElementById('category-modal');
  document.getElementById('cat-modal-title').textContent = id ? '编辑分类' : '新增分类';
  if (id) {
    const cat = adminCategories.find(c => c.id === id);
    document.getElementById('cat-field-id').value = cat.id;
    document.getElementById('cat-field-id').disabled = true;
    document.getElementById('cat-field-name').value = cat.name;
    document.getElementById('cat-field-icon').value = cat.icon;
  } else {
    document.getElementById('cat-field-id').value = '';
    document.getElementById('cat-field-id').disabled = false;
    document.getElementById('cat-field-name').value = '';
    document.getElementById('cat-field-icon').value = '';
  }
  modal.classList.remove('hidden');
}

function closeCategoryEditor() {
  document.getElementById('category-modal').classList.add('hidden');
  currentEditCatId = null;
}

function saveCategory() {
  const id = document.getElementById('cat-field-id').value.trim();
  const name = document.getElementById('cat-field-name').value.trim();
  const icon = document.getElementById('cat-field-icon').value.trim() || '📂';
  if (!id || !name) { showToast('请填写 ID 和名称', 'error'); return; }

  if (currentEditCatId) {
    const idx = adminCategories.findIndex(c => c.id === currentEditCatId);
    adminCategories[idx] = { ...adminCategories[idx], name, icon };
    // 同步文章的 categoryName/categoryIcon
    adminArticles = adminArticles.map(a => {
      if (a.category === currentEditCatId) return { ...a, categoryName: name, categoryIcon: icon };
      return a;
    });
    showToast('分类已更新');
  } else {
    if (adminCategories.find(c => c.id === id)) { showToast('该 ID 已存在', 'error'); return; }
    adminCategories.push({ id, name, icon, count: 0 });
    showToast('分类已添加');
  }
  saveToStorage();
  closeCategoryEditor();
  renderCategoryList();
}

function confirmDeleteCategory(id) {
  const cat = adminCategories.find(c => c.id === id);
  const count = adminArticles.filter(a => a.category === id).length;
  const extra = count > 0 ? `（该分类下有 ${count} 篇文章，删除后这些文章的分类将丢失）` : '';
  openConfirm(`确定要删除分类「${cat.name}」吗？${extra}`, () => {
    adminCategories = adminCategories.filter(c => c.id !== id);
    saveToStorage();
    renderCategoryList();
    showToast('分类已删除');
  });
}

// ============================================================
//  标签管理
// ============================================================

let currentEditTagId = null;

function renderTagList() {
  const container = document.getElementById('tag-list');
  if (adminTags.length === 0) {
    container.innerHTML = `<div class="empty-state"><div class="empty-icon">🏷</div><p>暂无标签</p></div>`;
    return;
  }
  container.innerHTML = adminTags.map(tag => `
    <div class="tag-chip">
      <span>${tag.name}</span>
      <span class="tag-chip-id">#${tag.id}</span>
      <span style="color:var(--color-primary);font-size:11px">${tag.count || 0}篇</span>
      <button onclick="openTagEditor('${tag.id}')" title="编辑">✏️</button>
      <button onclick="confirmDeleteTag('${tag.id}')" title="删除">🗑</button>
    </div>
  `).join('');
}

function openTagEditor(id) {
  currentEditTagId = id;
  const modal = document.getElementById('tag-modal');
  document.getElementById('tag-modal-title').textContent = id ? '编辑标签' : '新增标签';
  if (id) {
    const tag = adminTags.find(t => t.id === id);
    document.getElementById('tag-field-id').value = tag.id;
    document.getElementById('tag-field-id').disabled = true;
    document.getElementById('tag-field-name').value = tag.name;
  } else {
    document.getElementById('tag-field-id').value = '';
    document.getElementById('tag-field-id').disabled = false;
    document.getElementById('tag-field-name').value = '';
  }
  modal.classList.remove('hidden');
}

function closeTagEditor() {
  document.getElementById('tag-modal').classList.add('hidden');
  currentEditTagId = null;
}

function saveTag() {
  const id = document.getElementById('tag-field-id').value.trim();
  const name = document.getElementById('tag-field-name').value.trim();
  if (!id || !name) { showToast('请填写 ID 和名称', 'error'); return; }

  if (currentEditTagId) {
    const idx = adminTags.findIndex(t => t.id === currentEditTagId);
    adminTags[idx] = { ...adminTags[idx], name };
    showToast('标签已更新');
  } else {
    if (adminTags.find(t => t.id === id)) { showToast('该 ID 已存在', 'error'); return; }
    adminTags.push({ id, name, count: 0 });
    showToast('标签已添加');
  }
  saveToStorage();
  closeTagEditor();
  renderTagList();
}

function confirmDeleteTag(id) {
  const tag = adminTags.find(t => t.id === id);
  openConfirm(`确定要删除标签「${tag.name}」吗？`, () => {
    adminTags = adminTags.filter(t => t.id !== id);
    // 从文章中移除这个标签
    adminArticles = adminArticles.map(a => ({
      ...a,
      tags: (a.tags || []).filter(tid => tid !== id)
    }));
    saveToStorage();
    renderTagList();
    showToast('标签已删除');
  });
}

// ============================================================
//  确认弹窗
// ============================================================

function openConfirm(text, onConfirm) {
  document.getElementById('confirm-text').textContent = text;
  document.getElementById('confirm-modal').classList.remove('hidden');
  confirmCallback = onConfirm;
  document.getElementById('confirm-ok-btn').onclick = () => {
    closeConfirm();
    if (confirmCallback) confirmCallback();
  };
}

function closeConfirm() {
  document.getElementById('confirm-modal').classList.add('hidden');
  confirmCallback = null;
}

// ============================================================
//  数据导出
// ============================================================

function generateDataJS() {
  const esc = s => (s || '').replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$/g, '\\$');

  const categoriesStr = adminCategories.map(c => `  { id: "${c.id}", name: "${c.name}", icon: "${c.icon}", count: ${c.count || 0} }`).join(',\n');
  const tagsStr = adminTags.map(t => `  { id: "${t.id}", name: "${t.name}", count: ${t.count || 0} }`).join(',\n');
  const articlesStr = adminArticles.map(a => {
    const tagsArr = (a.tags || []).map(t => `"${t}"`).join(', ');
    return `  {
    id: "${a.id}",
    title: "${(a.title || '').replace(/"/g, '\\"')}",
    excerpt: "${(a.excerpt || '').replace(/"/g, '\\"')}",
    category: "${a.category}",
    categoryName: "${a.categoryName || ''}",
    categoryIcon: "${a.categoryIcon || ''}",
    tags: [${tagsArr}],
    date: "${a.date || ''}",
    readTime: "${a.readTime || ''}",
    featured: ${!!a.featured},
    coverEmoji: "${a.coverEmoji || '📄'}",
    coverColor: "${(a.coverColor || '').replace(/"/g, '\\"')}",
    content: \`${esc(a.content || '')}\`
  }`;
  }).join(',\n');

  return `/* ====================================
   蒲草书屋 - 文章数据
   最后更新：${new Date().toLocaleString('zh-CN')}
   ==================================== */

const CATEGORIES = [
${categoriesStr}
];

const TAGS = [
${tagsStr}
];

const ARTICLES = [
${articlesStr}
];
`;
}

function exportDataJS() {
  const code = generateDataJS();
  const blob = new Blob([code], { type: 'application/javascript' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'data.js';
  a.click();
  URL.revokeObjectURL(url);
  showToast('data.js 已下载，请替换 js/data.js 文件');
}

function copyDataJS() {
  const code = generateDataJS();
  navigator.clipboard.writeText(code).then(() => {
    showToast('代码已复制到剪贴板');
  }).catch(() => {
    showToast('复制失败，请手动复制', 'error');
  });
}

function resetToDefault() {
  openConfirm('确定要重置所有数据吗？将恢复为 data.js 的原始内容，你在后台的所有修改将丢失，此操作不可撤销。', () => {
    localStorage.removeItem(STORAGE_KEY_ARTICLES);
    localStorage.removeItem(STORAGE_KEY_CATEGORIES);
    localStorage.removeItem(STORAGE_KEY_TAGS);
    adminArticles = JSON.parse(JSON.stringify(ARTICLES));
    adminCategories = JSON.parse(JSON.stringify(CATEGORIES));
    adminTags = JSON.parse(JSON.stringify(TAGS));
    showToast('已恢复初始数据');
    renderArticleList();
  });
}

// ============================================================
//  ESC 关闭弹窗
// ============================================================

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    closeEditor();
    closeCategoryEditor();
    closeTagEditor();
    closeConfirm();
  }
});

// 点击遮罩关闭
document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', e => {
    if (e.target === overlay) {
      closeEditor();
      closeCategoryEditor();
      closeTagEditor();
      closeConfirm();
    }
  });
});

// ============================================================
//  初始化
// ============================================================

function initAdmin() {\n  console.log('初始化管理后台');\n  // 绑定导航项点击事件\n  document.querySelectorAll('.nav-item').forEach(item => {\n    item.addEventListener('click', e => {\n      e.preventDefault();\n      const page = item.dataset.page;\n      switchPage(page);\n    });\n  });
  // 初始化分类过滤下拉
  const catSelect = document.getElementById('filter-category');
  catSelect.innerHTML = '<option value="all">全部分类</option>' +
    adminCategories.filter(c => c.id !== 'all').map(c =>
      `<option value="${c.id}">${c.icon} ${c.name}</option>`
    ).join('');

  renderArticleList();
}

initAdmin();
